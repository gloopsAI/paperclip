+"""Fail-closed terminal route evidence for the structured ``/v1/runs`` API.
+
+This module deliberately has no provider SDK dependencies.  It observes the
+already-resolved Hermes execution boundary and retains only typed route and
+usage facts; prompt and response bodies are never stored here.
+"""
+
+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import threading
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional
+
+
+SCHEMA_VERSION = "gloops.hermes-terminal-evidence.v1"
+_DIGEST_DOMAIN = b"gloops.hermes-terminal-evidence.v1\0"
+_TERMINAL_STATUSES = frozenset({"completed", "failed", "cancelled"})
+
+
+class EvidenceError(RuntimeError):
+    """Base class for terminal-evidence failures."""
+
+
+class EvidenceIncompleteError(EvidenceError):
+    """Raised when a completed run lacks mandatory authoritative evidence."""
+
+
+class EvidenceFrozenError(EvidenceError):
+    """Raised when a provider callback attempts to mutate terminal evidence."""
+
+
+@dataclass(frozen=True)
+class UsageValue:
+    present: bool
+    value: int
+
+    def as_dict(self) -> dict[str, Any]:
+        return {"present": self.present, "value": self.value}
+
+
+@dataclass(frozen=True)
+class RouteFact:
+    provider: str
+    model: str
+    transport_class: str
+    billing_class: str
+
+    def as_dict(self) -> dict[str, str]:
+        return {
+            "provider": self.provider,
+            "model": self.model,
+            "transportClass": self.transport_class,
+            "billingClass": self.billing_class,
+        }
+
+
+def _mapping(value: Any) -> Mapping[str, Any]:
+    if isinstance(value, Mapping):
+        return value
+    if value is None:
+        return {}
+    model_dump = getattr(value, "model_dump", None)
+    if callable(model_dump):
+        dumped = model_dump()
+        if isinstance(dumped, Mapping):
+            return dumped
+    attrs = getattr(value, "__dict__", None)
+    return attrs if isinstance(attrs, Mapping) else {}
+
+
+def _strict_nonnegative_int(container: Mapping[str, Any], key: str) -> UsageValue:
+    if key not in container or container[key] is None:
+        return UsageValue(False, 0)
+    value = container[key]
+    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+        raise EvidenceError(f"usage field {key!r} must be a non-negative integer")
+    return UsageValue(True, value)
+
+
+def extract_usage_presence(raw_usage: Any, api_mode: str) -> dict[str, UsageValue]:
+    """Extract input/output/cache buckets without inventing zero.
+
+    The initial accepted route is Ollama Cloud's OpenAI-compatible chat
+    completions transport.  Responses-style names are supported as a strict
+    additive path.  Unknown transports return absent buckets and therefore
+    cannot terminalize as ``completed``.
+    """
+
+    usage = _mapping(raw_usage)
+    if not usage:
+        absent = UsageValue(False, 0)
+        return {"input": absent, "output": absent, "cached": absent}
+
+    normalized_mode = str(api_mode or "").strip().lower()
+    if normalized_mode in {"chat_completions", "openai_chat_completions"}:
+        prompt = _strict_nonnegative_int(usage, "prompt_tokens")
+        output = _strict_nonnegative_int(usage, "completion_tokens")
+        details = _mapping(usage.get("prompt_tokens_details"))
+        cached = _strict_nonnegative_int(details, "cached_tokens")
+    elif normalized_mode in {"responses", "codex_responses", "openai_responses"}:
+        prompt = _strict_nonnegative_int(usage, "input_tokens")
+        output = _strict_nonnegative_int(usage, "output_tokens")
+        details = _mapping(usage.get("input_tokens_details"))
+        cached = _strict_nonnegative_int(details, "cached_tokens")
+    else:
+        absent = UsageValue(False, 0)
+        return {"input": absent, "output": absent, "cached": absent}
+
+    if prompt.present and cached.present and cached.value > prompt.value:
+        raise EvidenceError("cached usage cannot exceed total provider input usage")
+    return {
+        # Provider input is the provider's reported total input bucket. Cached
+        # input is an independently present sub-bucket, not a prerequisite for
+        # knowing the total input count.
+        "input": prompt,
+        "output": output,
+        "cached": cached,
+    }
+
+
+def _validate_projection_value(value: Any, path: str = "projection") -> None:
+    """Enforce the restricted RFC 8785 value domain used by this schema."""
+
+    if value is None or isinstance(value, str):
+        return
+    if isinstance(value, bool):
+        return
+    if isinstance(value, int):
+        if value < 0:
+            raise EvidenceError(f"{path} contains a negative integer")
+        return
+    if isinstance(value, list):
+        for index, item in enumerate(value):
+            _validate_projection_value(item, f"{path}[{index}]")
+        return
+    if isinstance(value, dict):
+        for key, item in value.items():
+            if not isinstance(key, str) or not key.isascii():
+                raise EvidenceError(f"{path} contains a non-ASCII object key")
+            _validate_projection_value(item, f"{path}.{key}")
+        return
+    raise EvidenceError(f"{path} contains unsupported type {type(value).__name__}")
+
+
+def canonical_projection_bytes(projection: dict[str, Any]) -> bytes:
+    """Return RFC 8785 bytes for this schema's restricted JSON value domain.
+
+    All object keys are schema-owned ASCII strings and all numeric values are
+    integers.  Under that restricted domain, Python's compact, UTF-8,
+    lexicographically key-sorted JSON encoding is RFC 8785 canonical JSON.
+    """
+
+    _validate_projection_value(projection)
+    return json.dumps(
+        projection,
+        ensure_ascii=False,
+        allow_nan=False,
+        separators=(",", ":"),
+        sort_keys=True,
+    ).encode("utf-8")
+
+
+def terminal_evidence_digest(projection: dict[str, Any]) -> str:
+    return hashlib.sha256(_DIGEST_DOMAIN + canonical_projection_bytes(projection)).hexdigest()
+
+
+def transport_class_for_api_mode(api_mode: str) -> str:
+    mode = str(api_mode or "").strip().lower()
+    return {
+        "chat_completions": "openai_chat_completions",
+        "openai_chat_completions": "openai_chat_completions",
+        "responses": "openai_responses",
+        "openai_responses": "openai_responses",
+        "codex_responses": "openai_responses",
+        "anthropic_messages": "anthropic_messages",
+    }.get(mode, "unknown")
+
+
+class RunEvidenceAccumulator:
+    """Thread-safe, single-terminalization evidence accumulator."""
+
+    def __init__(self, *, run_id: str, request_byte_length: int, request_sha256: str):
+        if not run_id:
+            raise EvidenceError("run_id is required")
+        if isinstance(request_byte_length, bool) or request_byte_length < 0:
+            raise EvidenceError("request_byte_length must be non-negative")
+        if (
+            not isinstance(request_sha256, str)
+            or len(request_sha256) != 64
+            or any(ch not in "0123456789abcdef" for ch in request_sha256)
+        ):
+            raise EvidenceError("request_sha256 must be lowercase SHA-256 hex")
+        self._run_id = run_id
+        self._request_byte_length = request_byte_length
+        self._request_sha256 = request_sha256
+        self._routes: list[RouteFact] = []
+        self._resolved_route: Optional[RouteFact] = None
+        self._usage_totals = {"input": 0, "output": 0, "cached": 0}
+        self._usage_all_present = {"input": True, "output": True, "cached": True}
+        self._turn_total = 0
+        self._tool_call_total = 0
+        self._contradictions: list[str] = []
+        self._frozen = False
+        self._terminal: Optional[dict[str, Any]] = None
+        self._lock = threading.RLock()
+
+    @staticmethod
+    def _route(
+        *,
+        provider: str,
+        model: str,
+        transport_class: str,
+        billing_class: str,
+    ) -> RouteFact:
+        return RouteFact(
+            provider=str(provider or "").strip(),
+            model=str(model or "").strip(),
+            transport_class=str(transport_class or "").strip(),
+            billing_class=str(billing_class or "").strip(),
+        )
+
+    def _ensure_mutable(self) -> None:
+        if self._frozen:
+            raise EvidenceFrozenError("terminal evidence is already frozen")
+
+    def record_provider_attempt(
+        self,
+        *,
+        provider: str,
+        model: str,
+        transport_class: str,
+        billing_class: str,
+    ) -> None:
+        route = self._route(
+            provider=provider,
+            model=model,
+            transport_class=transport_class,
+            billing_class=billing_class,
+        )
+        with self._lock:
+            self._ensure_mutable()
+            # Preserve every call attempt, including same-route retries. A
+            # compressed list of distinct routes would not be an authoritative
+            # record of the fallback/retry path actually executed.
+            self._routes.append(route)
+
+    def record_provider_response(
+        self,
+        *,
+        response: Any,
+        provider: str,
+        model: str,
+        transport_class: str,
+        billing_class: str,
+        tool_call_count: int,
+    ) -> None:
+        if isinstance(tool_call_count, bool) or not isinstance(tool_call_count, int) or tool_call_count < 0:
+            raise EvidenceError("tool_call_count must be a non-negative integer")
+        route = self._route(
+            provider=provider,
+            model=model,
+            transport_class=transport_class,
+            billing_class=billing_class,
+        )
+        usage = extract_usage_presence(getattr(response, "usage", None), transport_class)
+        response_model = str(getattr(response, "model", "") or "").strip()
+        with self._lock:
+            self._ensure_mutable()
+            if not self._routes:
+                self._contradictions.append("provider response has no matching request attempt")
+            elif self._routes[-1] != route:
+                self._contradictions.append(
+                    "provider response route does not match the latest request attempt"
+                )
+            if not response_model:
+                self._contradictions.append("provider response model is missing")
+            elif response_model != route.model:
+                self._contradictions.append(
+                    f"provider response model {response_model!r} != sent model {route.model!r}"
+                )
+            self._resolved_route = route
+            self._turn_total += 1
+            self._tool_call_total += tool_call_count
+            for name, bucket in usage.items():
+                self._usage_all_present[name] = self._usage_all_present[name] and bucket.present
+                if bucket.present:
+                    self._usage_totals[name] += bucket.value
+
+    def reconcile_reported_usage(self, reported_usage: Mapping[str, Any]) -> None:
+        """Compare the gateway's legacy aggregate with provider evidence."""
+
+        required = ("input_tokens", "output_tokens", "total_tokens")
+        parsed: dict[str, int] = {}
+        for key in required:
+            value = reported_usage.get(key)
+            if isinstance(value, bool) or not isinstance(value, int) or value < 0:
+                raise EvidenceError(
+                    f"reported usage field {key!r} must be a non-negative integer"
+                )
+            parsed[key] = value
+        with self._lock:
+            self._ensure_mutable()
+            if parsed["input_tokens"] != self._usage_totals["input"]:
+                self._contradictions.append(
+                    "reported input usage does not match provider response aggregate"
+                )
+            if parsed["output_tokens"] != self._usage_totals["output"]:
+                self._contradictions.append(
+                    "reported output usage does not match provider response aggregate"
+                )
+            if parsed["total_tokens"] != (
+                parsed["input_tokens"] + parsed["output_tokens"]
+            ):
+                self._contradictions.append(
+                    "reported total usage does not equal reported input plus output"
+                )
+
+    def _missing_completed_facts(self) -> list[str]:
+        missing: list[str] = []
+        route = self._resolved_route
+        if route is None:
+            missing.append("resolvedRoute")
+        else:
+            for name, value in (
+                ("resolvedProvider", route.provider),
+                ("resolvedModel", route.model),
+                ("transportClass", route.transport_class),
+                ("billingClass", route.billing_class),
+            ):
+                if not value or value == "unknown":
+                    missing.append(name)
+        if not self._routes:
+            missing.append("fallbackPath")
+        for index, attempted in enumerate(self._routes, start=1):
+            if attempted.provider != "ollama-cloud":
+                missing.append(
+                    f"fallbackPath[{index}].provider={attempted.provider or 'missing'} "
+                    "is outside the Ollama Cloud subscription boundary"
+                )
+            if attempted.billing_class != "subscription_included":
+                missing.append(
+                    f"fallbackPath[{index}].billingClass="
+                    f"{attempted.billing_class or 'missing'} is not subscription_included"
+                )
+            if attempted.transport_class != "openai_chat_completions":
+                missing.append(
+                    f"fallbackPath[{index}].transportClass="
+                    f"{attempted.transport_class or 'missing'} is not openai_chat_completions"
+                )
+            if not attempted.model:
+                missing.append(f"fallbackPath[{index}].model")
+        if self._turn_total < 1:
+            missing.append("turnTotal")
+        for name in ("input", "output", "cached"):
+            if not self._usage_all_present[name]:
+                missing.append(f"{name}Usage")
+        missing.extend(self._contradictions)
+        return missing
+
+    def finalize(self, terminal_status: str) -> dict[str, Any]:
+        status = str(terminal_status or "").strip().lower()
+        if status not in _TERMINAL_STATUSES:
+            raise EvidenceError(f"unsupported terminal status {terminal_status!r}")
+        with self._lock:
+            if self._terminal is not None:
+                if self._terminal["terminalEvidence"]["terminalStatus"] != status:
+                    raise EvidenceFrozenError("terminal evidence cannot change terminal status")
+                return copy.deepcopy(self._terminal)
+
+            missing = self._missing_completed_facts()
+            if status == "completed" and missing:
+                raise EvidenceIncompleteError(
+                    "completed run lacks authoritative evidence: " + ", ".join(missing)
+                )
+
+            route = self._resolved_route or (self._routes[-1] if self._routes else RouteFact("", "", "", ""))
+            projection = {
+                "schemaVersion": SCHEMA_VERSION,
+                "hermesRunId": self._run_id,
+                "requestByteLength": self._request_byte_length,
+                "requestSha256": self._request_sha256,
+                "resolvedProvider": route.provider,
+                "resolvedModel": route.model,
+                "transportClass": route.transport_class,
+                "billingClass": route.billing_class,
+                "fallbackPath": [item.as_dict() for item in self._routes],
+                "inputUsage": UsageValue(
+                    self._turn_total > 0 and self._usage_all_present["input"],
+                    self._usage_totals["input"],
+                ).as_dict(),
+                "outputUsage": UsageValue(
+                    self._turn_total > 0 and self._usage_all_present["output"],
+                    self._usage_totals["output"],
+                ).as_dict(),
+                "cachedUsage": UsageValue(
+                    self._turn_total > 0 and self._usage_all_present["cached"],
+                    self._usage_totals["cached"],
+                ).as_dict(),
+                "usageSource": "provider_response_aggregate" if self._turn_total else "unavailable",
+                "turnTotal": self._turn_total,
+                "toolCallTotal": self._tool_call_total,
+                "terminalStatus": status,
+            }
+            terminal = {
+                "terminalEvidence": projection,
+                "terminalEvidenceDigest": terminal_evidence_digest(projection),
+            }
+            self._terminal = copy.deepcopy(terminal)
+            self._frozen = True
+            return copy.deepcopy(terminal)
