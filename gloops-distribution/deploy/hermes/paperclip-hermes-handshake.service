[Unit]
Description=Paperclip Hermes one-turn zero-tool provider handshake (operator-activated only)
Documentation=https://github.com/gloopsAI/paperclip/tree/gloops/stable/gloops-distribution/deploy/hermes
BindsTo=paperclip-hermes-handshake-egress.service
Requires=docker.service paperclip-hermes-handshake-egress.service
After=docker.service network-online.target paperclip-hermes-handshake-egress.service
Wants=network-online.target
Conflicts=paperclip-hermes-execution.service
ConditionPathExists=/etc/paperclip-gloops/HERMES_HANDSHAKE_APPROVED
StartLimitIntervalSec=900
StartLimitBurst=1

[Service]
Type=simple
Environment=HERMES_HANDSHAKE_IMAGE=sha256:d5394064690c323d2ec7e62defc0dd8986be080dcc18489998b2d6edd96b4fac
ExecStartPre=/usr/local/lib/paperclip-gloops/verify-hermes-handshake-profile.sh --source
ExecStartPre=-/usr/bin/docker rm -f paperclip-hermes-handshake
ExecStartPre=/usr/bin/test ! -e /etc/paperclip-gloops/HERMES_EXECUTION_APPROVED
ExecStartPre=/usr/bin/test ! -e /run/paperclip-gloops/HERMES_HANDSHAKE_ACTIVE
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /run/paperclip-gloops
ExecStartPre=/usr/bin/mv /etc/paperclip-gloops/HERMES_HANDSHAKE_APPROVED /run/paperclip-gloops/HERMES_HANDSHAKE_ACTIVE
ExecStart=/usr/bin/docker run --rm --name paperclip-hermes-handshake --pull never --read-only --tmpfs /run:rw,exec,nosuid,nodev,size=32m --tmpfs /tmp:rw,noexec,nosuid,nodev,size=64m --tmpfs /opt/data:rw,noexec,nosuid,nodev,size=128m,uid=10000,gid=10000,mode=0700 --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add SETGID --cap-add SETUID --cap-add KILL --security-opt no-new-privileges:true --network paperclip-handshake --ip 172.30.241.3 --network-alias hermes-execution --add-host paperclip-gloops:172.30.241.4 --dns 127.0.0.1 --env-file /etc/paperclip-gloops/hermes-execution.env --env HOME=/opt/data --env HERMES_HOME=/opt/data --env HERMES_WRITE_SAFE_ROOT=/opt/data --env HERMES_DISABLE_LAZY_INSTALLS=1 --env PYTHONPATH=/opt/paperclip-handshake-guard --env HTTPS_PROXY=http://172.30.241.1:18080 --env https_proxy=http://172.30.241.1:18080 --env NO_PROXY=127.0.0.1,localhost,hermes-execution,paperclip-gloops,172.30.241.0/29 --env no_proxy=127.0.0.1,localhost,hermes-execution,paperclip-gloops,172.30.241.0/29 --mount type=bind,src=/usr/local/lib/paperclip-gloops/hermes-handshake-resolv.conf,dst=/etc/resolv.conf,readonly --mount type=bind,src=/opt/paperclip/hermes-handshake-profile/config.yaml,dst=/opt/handshake-profile/config.yaml,readonly --mount type=bind,src=/opt/paperclip/hermes-handshake-profile/auth.json,dst=/opt/handshake-profile/auth.json,readonly --mount type=bind,src=/usr/local/lib/paperclip-gloops/hermes-handshake-guard/sitecustomize.py,dst=/opt/paperclip-handshake-guard/sitecustomize.py,readonly --memory 1024m --memory-swap 1024m --cpus 1.0 --pids-limit 256 --log-driver json-file --log-opt max-size=5m --log-opt max-file=2 --health-cmd "python -c \"import os,urllib.request; r=urllib.request.Request('http://127.0.0.1:8642/v1/models',headers={'Authorization':'Bearer '+os.environ['API_SERVER_KEY']}); raise SystemExit(0 if urllib.request.urlopen(r,timeout=3).status == 200 else 1)\"" --health-interval 5s --health-timeout 3s --health-retries 12 --health-start-period 20s --entrypoint /bin/sh ${HERMES_HANDSHAKE_IMAGE} -ec '/opt/hermes/.venv/bin/python -c "import httpx; from agent import agent_runtime_helpers as h; assert h.try_recover_primary_transport._paperclip_handshake_guard; assert httpx.Client._send_single_request._paperclip_handshake_guard; assert httpx.AsyncClient._send_single_request._paperclip_handshake_guard"; cp /opt/handshake-profile/config.yaml /opt/data/config.yaml; chmod 0400 /opt/data/config.yaml; chown 10000:10000 /opt/data/config.yaml; cp /opt/handshake-profile/auth.json /opt/data/auth.json; chmod 0600 /opt/data/auth.json; chown 10000:10000 /opt/data/auth.json; exec /init /opt/hermes/docker/main-wrapper.sh "$@"' handshake gateway run --replace
ExecStartPost=/usr/local/lib/paperclip-gloops/verify-hermes-handshake-profile.sh --live
ExecStop=-/usr/bin/docker stop --time 30 paperclip-hermes-handshake
ExecStopPost=-/usr/bin/docker rm -f paperclip-hermes-handshake
ExecStopPost=-/usr/bin/rm -f /run/paperclip-gloops/HERMES_HANDSHAKE_ACTIVE /etc/paperclip-gloops/HERMES_HANDSHAKE_APPROVED
Restart=no
RuntimeMaxSec=900
TimeoutStartSec=90
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
