+def _invoke_provider_with_run_evidence_gate(
+    agent: Any,
+    api_kwargs: Dict[str, Any],
+    provider_call: Any,
+    *,
+    middleware_runner: Any,
+    middleware_kwargs: dict[str, Any],
+) -> Any:
+    """Invoke the provider through exactly one receipt-aware boundary.
+
+    Receipt-governed calls reject non-subscription routes before publishing an
+    attempt or invoking the provider. They deliberately bypass execution
+    middleware so no middleware can observe, copy, or retain the raw request
+    or response objects. Unreceipted calls preserve the normal middleware
+    chain unchanged.
+    """
+
+    evidence = getattr(agent, "_gloops_run_evidence", None)
+    if evidence is None:
+        return middleware_runner(
+            api_kwargs,
+            provider_call,
+            **middleware_kwargs,
+        )
+    route = _validate_run_evidence_route(agent, api_kwargs)
+    if route is None:
+        raise RuntimeError("receipt-governed route validation produced no route")
+    evidence.record_provider_attempt(**route)
+    return provider_call(api_kwargs)
+
+
+def _record_run_evidence_response(
+    agent: Any,
+    api_kwargs: Optional[Dict[str, Any]],
+    response: Any,
+    *,
+    tool_call_count: int,
+) -> None:
+    evidence = getattr(agent, "_gloops_run_evidence", None)
+    if evidence is not None:
+        route = _run_evidence_route(agent, api_kwargs)
+        response_model = str(getattr(response, "model", "") or "").strip()
+        if not response_model:
+            raise RuntimeError("provider response omitted authoritative model")
+        evidence_response = response
+        if str(agent.provider or "").strip() == "moa":
+            # Native Hermes accounts reference usage separately from the raw
+            # acting-model response, then folds it into the run total. Mirror
+            # that existing accounting without consuming/resetting it so the
+            # normal session and gateway totals remain unchanged.
+            completions = getattr(
+                getattr(getattr(agent, "client", None), "chat", None),
+                "completions",
+                None,
+            )
+            combined_usage = getattr(agent, "_gloops_moa_combined_usage", None)
+            if combined_usage is not None:
+                delattr(agent, "_gloops_moa_combined_usage")
+            else:
+                reference_usage = getattr(
+                    completions,
+                    "_pending_reference_usage",
+                    None,
+                )
+                if reference_usage is None:
+                    combined_usage = None
+                else:
+                    acting_usage = normalize_usage(
+                        getattr(response, "usage", None),
+                        provider=route["provider"],
+                        api_mode=route["transport_class"],
+                    )
+                    combined_usage = acting_usage + reference_usage
+            if combined_usage is not None:
+                evidence_response = SimpleNamespace(
+                    model=response_model,
+                    usage=SimpleNamespace(
+                        prompt_tokens=combined_usage.prompt_tokens,
+                        completion_tokens=combined_usage.output_tokens,
+                        prompt_tokens_details=SimpleNamespace(
+                            cached_tokens=combined_usage.cache_read_tokens
+                        ),
+                    ),
+                )
+        evidence.record_provider_response(
+            response=evidence_response,
+            tool_call_count=tool_call_count,
+            **route,
+        )
+
+
