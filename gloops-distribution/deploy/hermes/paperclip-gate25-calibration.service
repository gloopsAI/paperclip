[Unit]
Description=One-use Gate 2.5 Paperclip calibration control plane
Documentation=https://github.com/gloopsAI/paperclip/tree/gloops/stable/gloops-distribution/deploy/hermes
Requires=docker.service paperclip-hermes-gate25-calibration.service paperclip-github-push-broker-gate25.service
After=docker.service network-online.target paperclip-hermes-gate25-calibration.service paperclip-github-push-broker-gate25.service
Wants=network-online.target
Conflicts=paperclip-gloops.service paperclip-gloops-handshake.service
ConditionPathExists=/run/paperclip-gate25/PAPERCLIP_ACTIVE
OnFailure=paperclip-gloops-alert@%n.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/run/paperclip-gate25/runtime.env
Environment=PAPERCLIP_IMAGE=ghcr.io/gloopsai/paperclip-gloops@sha256:c6cace2d01b45ee22275f4648155c75b72ec7cb0c7c361ddb1a9c48e9db7caa1
ExecStartPre=/usr/local/lib/paperclip-gloops/github-app-credentials.py refresh-projector
ExecStartPre=/usr/local/lib/paperclip-gloops/preflight-gate25-calibration.sh
ExecStartPre=-/usr/bin/docker rm -f paperclip-gloops
ExecStart=/usr/bin/docker run --rm --name paperclip-gloops --pull never --user 995:985 --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m --cap-drop ALL --security-opt no-new-privileges:true --network paperclip-execution --publish 127.0.0.1:3100:3100 --env-file /run/paperclip-gate25/runtime.env --mount type=bind,src=/home/paperclip/.paperclip,dst=/home/paperclip/.paperclip --mount type=bind,src=/opt/paperclip/plugins,dst=/opt/paperclip/plugins,readonly --mount type=bind,src=/home/paperclip/mte-shadow-package,dst=/home/paperclip/mte-shadow-package,readonly --mount type=bind,src=/opt/paperclip/hermes-execution-state/workspace,dst=/opt/data/workspace,readonly --mount type=bind,src=/etc/paperclip-gloops/github-broker-receipt-token,dst=/run/secrets/paperclip-github-broker-receipt-token,readonly --memory 1536m --memory-swap 1536m --cpus 2.0 --pids-limit 512 --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --health-cmd "node -e \"fetch('http://127.0.0.1:3100/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"" --health-interval 30s --health-timeout 5s --health-retries 3 --health-start-period 45s ${PAPERCLIP_IMAGE}
ExecStartPost=/usr/local/lib/paperclip-gloops/wait-paperclip-control-plane.sh
ExecStartPost=/usr/local/lib/paperclip-gloops/github-app-credentials.py rotate-projector
ExecStop=/usr/local/lib/paperclip-gloops/github-app-credentials.py clear-projector
ExecStop=/usr/bin/docker stop --time 45 paperclip-gloops
ExecStopPost=-/usr/local/lib/paperclip-gloops/github-app-credentials.py revoke-projector
ExecStopPost=-/usr/bin/docker rm -f paperclip-gloops
Restart=no
TimeoutStartSec=120
TimeoutStopSec=100

