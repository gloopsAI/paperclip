[Unit]
Description=Paperclip Hermes execution-only sidecar (operator-activated only)
Documentation=https://github.com/gloopsAI/paperclip/tree/gloops/stable/gloops-distribution/deploy/hermes
Requires=docker.service paperclip-campaign-deadman.service paperclip-github-push-broker.service paperclip-github-read-broker.service
BindsTo=paperclip-campaign-deadman.service paperclip-github-push-broker.service paperclip-github-read-broker.service
After=docker.service network-online.target paperclip-campaign-deadman.service paperclip-github-push-broker.service paperclip-github-read-broker.service
Wants=network-online.target
Conflicts=paperclip-hermes-handshake.service
ConditionPathExists=/etc/paperclip-gloops/HERMES_EXECUTION_APPROVED
StartLimitIntervalSec=900
StartLimitBurst=2

[Service]
Type=simple
Environment=HERMES_EXECUTION_IMAGE=sha256:fd1f8f68f600f8da0c42a38361d7333a8487015ed04ec5e6bcbed8b4bb9cb00b
ExecCondition=/usr/bin/test ! -e /run/paperclip-gloops/HERMES_HANDSHAKE_ACTIVE
ExecStartPre=/usr/local/lib/paperclip-gloops/verify-hermes-execution-profile.sh --source
ExecStartPre=/usr/local/lib/paperclip-gloops/verify-focused-test-runtime.sh
ExecStartPre=-/usr/bin/docker rm -f paperclip-hermes-execution
# s6-supervise is root while the gateway child is uid 10000. CAP_KILL is the
# narrow capability it needs to deliver the container's graceful-stop signal.
ExecStart=/usr/bin/docker run --rm --name paperclip-hermes-execution --group-add 985 --pull never --read-only --tmpfs /run:rw,exec,nosuid,nodev,size=64m --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m --tmpfs /opt/data:rw,nosuid,nodev,size=256m,uid=10000,gid=10000,mode=0700 --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add SETGID --cap-add SETUID --cap-add KILL --security-opt no-new-privileges:true --network paperclip-execution --network-alias hermes-execution --env-file /etc/paperclip-gloops/hermes-execution.env --env HOME=/opt/data --env HERMES_HOME=/opt/data --env HERMES_WRITE_SAFE_ROOT=/opt/data --env HERMES_DISABLE_LAZY_INSTALLS=1 --env GIT_CONFIG_COUNT=1 --env GIT_CONFIG_KEY_0=safe.directory --env GIT_CONFIG_VALUE_0=/opt/data/workspace/* --mount type=bind,src=/opt/paperclip/hermes-execution-profile/config.yaml,dst=/opt/data/config.yaml,readonly --mount type=bind,src=/opt/paperclip/hermes-execution-profile/auth.json,dst=/opt/data/auth.json --mount type=bind,src=/opt/paperclip/hermes-execution-profile/cron-disabled,dst=/opt/data/plugins/disabled,readonly --mount type=bind,src=/usr/local/lib/paperclip-gloops/tools,dst=/opt/data/bin,readonly --mount type=bind,src=/run/paperclip-github-broker,dst=/run/paperclip-github-broker --mount type=bind,src=/run/paperclip-github-read-broker,dst=/run/paperclip-github-read-broker --mount type=bind,src=/opt/paperclip/hermes-execution-state/cache,dst=/opt/data/cache --mount type=bind,src=/opt/paperclip/hermes-execution-state/logs,dst=/opt/data/logs --mount type=bind,src=/opt/paperclip/hermes-execution-state/memories,dst=/opt/data/memories --mount type=bind,src=/opt/paperclip/hermes-execution-state/sessions,dst=/opt/data/sessions --mount type=bind,src=/opt/paperclip/hermes-execution-state/workspace,dst=/opt/data/workspace --memory 2048m --memory-swap 2048m --cpus 2.0 --pids-limit 512 --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --health-cmd "python -c \"import os,urllib.request; r=urllib.request.Request('http://127.0.0.1:8642/v1/models',headers={'Authorization':'Bearer '+os.environ['API_SERVER_KEY']}); raise SystemExit(0 if urllib.request.urlopen(r,timeout=3).status == 200 else 1)\"" --health-interval 10s --health-timeout 5s --health-retries 6 --health-start-period 30s ${HERMES_EXECUTION_IMAGE} gateway run --replace
ExecStartPost=/usr/local/lib/paperclip-gloops/restore-hermes-workspace-observer.sh
ExecStop=/usr/local/lib/paperclip-gloops/stop-hermes-execution.py
ExecStopPost=-/usr/bin/docker rm -f paperclip-hermes-execution
Restart=on-failure
RestartSec=15
TimeoutStartSec=90
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
