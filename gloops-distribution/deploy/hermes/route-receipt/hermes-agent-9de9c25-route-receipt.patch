+    with pytest.raises(RuntimeError, match="omitted authoritative model"):
+        _record_run_evidence_response(
+            agent,
+            api_kwargs,
+            response,
+            tool_call_count=0,
+        )
+
+    fallback = evidence.finalize("failed")["terminalEvidence"]["fallbackPath"]
+    assert len(fallback) == 1
+    assert fallback[0]["provider"] == "ollama-cloud"
+
