FROM hermes-agent-gloops:bounded-runtime-v2@sha256:3fa158ecc7635512e6c0b33d68084de1eae33593ca009225cd2f7fbd7af2902d

ARG SOURCE_DATE_EPOCH
COPY route-receipt /tmp/route-receipt
ADD --checksum=sha256:a499b9ea663d2aeabe70c19e1ff3ac3b248922097a5f85566a1aa58238742d96 \
  https://github.com/NousResearch/hermes-agent/archive/9de9c25f620ff7f1ce0fd5457d596052d5159596.tar.gz \
  /tmp/hermes-source.tar.gz
RUN python /tmp/route-receipt/apply-hermes-route-receipt.py \
