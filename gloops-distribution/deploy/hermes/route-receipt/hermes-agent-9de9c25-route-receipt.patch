+def test_execution_seam_records_final_request_model_and_provider_response_usage():
+    evidence = RunEvidenceAccumulator(
+        run_id="run_capture",
+        request_byte_length=2,
+        request_sha256="4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e6f15fc2f9f7f57c15e3fcb",
+    )
+    agent = SimpleNamespace(
+        # Hermes may label an OpenAI-compatible endpoint generically. The
+        # endpoint-aware resolver must still record the actual Ollama Cloud
+        # subscription route.
+        provider="openai",
+        model="configured-alias",
+        api_mode="chat_completions",
+        base_url="https://ollama.com/v1",
+        _gloops_run_evidence=evidence,
+    )
+    final_api_kwargs = {"model": "qwen3-coder"}
+    calls = {"middleware": 0, "provider": 0}
+
+    def middleware(*_args, **_kwargs):
+        calls["middleware"] += 1
+        raise AssertionError("receipt-governed payload reached middleware")
+
+    response = SimpleNamespace(
+        model="qwen3-coder",
+        usage=SimpleNamespace(
+            prompt_tokens=10,
+            completion_tokens=2,
+            prompt_tokens_details=SimpleNamespace(cached_tokens=0),
+        ),
+    )
+
+    def provider(api_kwargs):
+        calls["provider"] += 1
+        assert api_kwargs is final_api_kwargs
+        return response
+
+    observed_response = _invoke_provider_with_run_evidence_gate(
+        agent,
+        final_api_kwargs,
+        provider,
+        middleware_runner=middleware,
+        middleware_kwargs={"raw": final_api_kwargs},
+    )
+    _record_run_evidence_response(
+        agent,
+        final_api_kwargs,
+        observed_response,
+        tool_call_count=1,
+    )
+
+    assert calls == {"middleware": 0, "provider": 1}
+    projection = evidence.finalize("completed")["terminalEvidence"]
+    assert projection["resolvedModel"] == "qwen3-coder"
+    assert projection["resolvedModel"] != agent.model
+    assert projection["resolvedProvider"] == "ollama-cloud"
+    assert projection["billingClass"] == "subscription_included"
+    assert projection["toolCallTotal"] == 1
+    assert _run_evidence_payload_observers_allowed(agent) is False
+
