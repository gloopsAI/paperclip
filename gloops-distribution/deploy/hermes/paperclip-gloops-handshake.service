[Unit]
Description=GLoops Paperclip control plane for one zero-authority provider handshake
Documentation=https://github.com/gloopsAI/paperclip/tree/gloops/stable/gloops-distribution/deploy/hermes
Requires=docker.service paperclip-hermes-handshake.service
After=docker.service network-online.target paperclip-hermes-handshake.service
Wants=network-online.target
Conflicts=paperclip-gloops.service
ConditionPathExists=/etc/paperclip-gloops/ACTIVATION_APPROVED
OnFailure=paperclip-gloops-alert@%n.service
StartLimitIntervalSec=900
StartLimitBurst=1

[Service]
Type=simple
EnvironmentFile=/etc/paperclip-gloops/runtime.env
Environment=PAPERCLIP_IMAGE=ghcr.io/gloopsai/paperclip-gloops@sha256:4ad5881969635daec4194f7bb78df22a1768df4f74f574cc935647d24750a23d
Environment=PAPERCLIP_CONTAINER=paperclip-gloops-handshake
ExecStartPre=/usr/bin/test -e /run/paperclip-gloops/HERMES_HANDSHAKE_ACTIVE
ExecStartPre=/usr/bin/test ! -e /run/paperclip-gloops/PAPERCLIP_HANDSHAKE_ACTIVE
ExecStartPre=/usr/bin/systemctl is-active --quiet paperclip-hermes-handshake.service
ExecStartPre=/usr/bin/mv /etc/paperclip-gloops/ACTIVATION_APPROVED /run/paperclip-gloops/PAPERCLIP_HANDSHAKE_ACTIVE
ExecStartPre=/usr/local/lib/paperclip-gloops/preflight.sh
ExecStartPre=-/usr/bin/docker rm -f paperclip-gloops-handshake
ExecStart=/usr/bin/docker run --rm --name paperclip-gloops-handshake --pull never --user 995:985 --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=256m --cap-drop ALL --security-opt no-new-privileges:true --network paperclip-execution --network-alias paperclip-gloops --publish 127.0.0.1:3100:3100 --env-file /etc/paperclip-gloops/runtime.env --mount type=bind,src=/home/paperclip/.paperclip,dst=/home/paperclip/.paperclip --mount type=bind,src=/opt/paperclip/plugins,dst=/opt/paperclip/plugins,readonly --mount type=bind,src=/home/paperclip/mte-shadow-package,dst=/home/paperclip/mte-shadow-package,readonly --memory 1536m --memory-swap 1536m --cpus 2.0 --pids-limit 512 --log-driver json-file --log-opt max-size=10m --log-opt max-file=3 --health-cmd "node -e \"fetch('http://127.0.0.1:3100/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\"" --health-interval 30s --health-timeout 5s --health-retries 3 --health-start-period 45s ${PAPERCLIP_IMAGE}
ExecStartPost=/usr/local/lib/paperclip-gloops/wait-paperclip-control-plane.sh
ExecStop=-/usr/bin/docker stop --time 45 paperclip-gloops-handshake
ExecStopPost=-/usr/bin/docker rm -f paperclip-gloops-handshake
ExecStopPost=-/usr/bin/rm -f /run/paperclip-gloops/PAPERCLIP_HANDSHAKE_ACTIVE /etc/paperclip-gloops/ACTIVATION_APPROVED
Restart=no
RuntimeMaxSec=900
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
