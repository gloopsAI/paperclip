+def _run_evidence_moa_route(agent: Any) -> dict[str, str]:
+    """Resolve a native MoA preset to its acting Ollama subscription route.
+
+    Hermes exposes MoA as a virtual provider, but every real provider call is
+    defined by the preset's reference and aggregator slots. Receipt-governed
+    execution accepts the virtual route only when every slot remains inside
+    Ollama Cloud and the aggregator is the acting model.
+    """
+
+    from hermes_cli.config import load_config
+    from hermes_cli.moa_config import resolve_moa_preset
+
+    preset_name = str(agent.model or "").strip()
+    preset = resolve_moa_preset(load_config().get("moa") or {}, preset_name)
+    aggregator = preset.get("aggregator") or {}
+    slots = [*(preset.get("reference_models") or []), aggregator]
+    if not preset.get("enabled", True) or not preset_name or not aggregator or not slots:
+        raise RuntimeError("receipt-governed MoA route has no enabled acting preset")
+
+    resolved_slots = [
+        resolve_billing_route(
+            str(slot.get("model") or "").strip(),
+            provider=str(slot.get("provider") or "").strip(),
+            base_url=str(slot.get("base_url") or "").strip() or None,
+        )
+        for slot in slots
+    ]
+    if any(
+        not route.model
+        or route.provider != "ollama-cloud"
+        or route.billing_mode != "subscription_included"
+        for route in resolved_slots
+    ):
+        raise RuntimeError(
+            "receipt-governed MoA route refused: every reference and acting "
+            "model must use the Ollama Cloud subscription"
+        )
+
+    acting = resolved_slots[-1]
+    return {
+        "provider": acting.provider,
+        "model": acting.model,
+        "transport_class": "openai_chat_completions",
+        "billing_class": acting.billing_mode,
+    }
+
+
+def _run_evidence_route(agent: Any, api_kwargs: Optional[Dict[str, Any]]) -> dict[str, str]:
+    configured_provider = str(agent.provider or "").strip()
+    if configured_provider == "moa":
+        return _run_evidence_moa_route(agent)
+
+    model = str((api_kwargs or {}).get("model") or agent.model or "").strip()
+    transport_class = transport_class_for_api_mode(agent.api_mode)
+    billing = resolve_billing_route(
+        model,
+        provider=configured_provider,
+        base_url=agent.base_url,
+    )
+    return {
+        # The endpoint-aware billing resolver normalizes OpenAI-compatible
+        # Ollama Cloud routes to ``ollama-cloud``. The raw configured provider
+        # name alone is not authoritative for a custom-compatible endpoint.
+        "provider": billing.provider,
+        "model": billing.model,
+        "transport_class": transport_class,
+        "billing_class": billing.billing_mode,
+    }
+
+
+def _validate_run_evidence_route(
+    agent: Any,
+    api_kwargs: Optional[Dict[str, Any]],
+) -> Optional[dict[str, str]]:
+    evidence = getattr(agent, "_gloops_run_evidence", None)
+    if evidence is not None:
+        route = _run_evidence_route(agent, api_kwargs)
+        if (
+            route["provider"] != "ollama-cloud"
+            or route["billing_class"] != "subscription_included"
+            or route["transport_class"] != "openai_chat_completions"
+        ):
+            raise RuntimeError(
+                "receipt-governed run refused before provider call: "
+                f"provider={route['provider']!r} billing={route['billing_class']!r} "
+                f"transport={route['transport_class']!r}"
+            )
+        return route
+    return None
+
