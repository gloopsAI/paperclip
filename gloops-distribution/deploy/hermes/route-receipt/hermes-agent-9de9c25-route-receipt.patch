+def _json_object_without_duplicates(pairs: List[tuple[str, Any]]) -> Dict[str, Any]:
+    result: Dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"duplicate JSON object key: {key}")
+        result[key] = value
+    return result
+
+
+def _reject_nonfinite_json_constant(value: str) -> None:
+    raise ValueError(f"non-finite JSON number is not allowed: {value}")
+
+
+async def _read_strict_json_object(
+    request: "web.Request",
+) -> tuple[Dict[str, Any], int, str]:
+    """Read one JSON entity without letting aiohttp retain a raw-body copy."""
+
+    if request.content_length is not None and request.content_length > MAX_REQUEST_BYTES:
+        raise _RequestBodyTooLargeError("request body exceeds limit")
+
+    digest = hashlib.sha256()
+    raw = bytearray()
+    decoded: Optional[str] = None
+    try:
+        while True:
+            chunk = await request.content.read(64 * 1024)
+            if not chunk:
+                break
+            if len(raw) + len(chunk) > MAX_REQUEST_BYTES:
+                raise _RequestBodyTooLargeError("request body exceeds limit")
+            digest.update(chunk)
+            raw.extend(chunk)
+
+        byte_length = len(raw)
+        entity_sha256 = digest.hexdigest()
+        decoded = raw.decode("utf-8", errors="strict")
+        body = json.loads(
+            decoded,
+            object_pairs_hook=_json_object_without_duplicates,
+            parse_constant=_reject_nonfinite_json_constant,
+        )
+        if not isinstance(body, dict):
+            raise ValueError("JSON body must be an object")
+        return body, byte_length, entity_sha256
+    finally:
+        # The parsed object remains available to the existing request path.
+        # Overwrite and release the exact entity bytes and decoded string; the
+        # new receipt retains only their length and digest.
+        if raw:
+            raw[:] = b"\0" * len(raw)
+        raw.clear()
+        decoded = None
+
