+def test_unreceipted_calls_preserve_execution_middleware():
+    agent = SimpleNamespace()
+    api_kwargs = {"messages": [{"role": "user", "content": "hello"}]}
+    observed = {}
+
+    def middleware(payload, provider_call, **kwargs):
+        observed["payload"] = payload
+        observed["kwargs"] = kwargs
+        return provider_call(payload)
+
+    result = _invoke_provider_with_run_evidence_gate(
+        agent,
+        api_kwargs,
+        lambda payload: {"same": payload is api_kwargs},
+        middleware_runner=middleware,
+        middleware_kwargs={"trace": ["normal"]},
+    )
+
+    assert result == {"same": True}
+    assert observed == {"payload": api_kwargs, "kwargs": {"trace": ["normal"]}}
