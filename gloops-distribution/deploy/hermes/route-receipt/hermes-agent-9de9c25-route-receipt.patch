+    with pytest.raises(EvidenceIncompleteError, match="provider response model"):
+        contradiction.finalize("completed")
+
+
+def test_reported_usage_contradiction_fails_completed_terminalization():
+    acc = _accumulator()
+    _record_success(acc)
+    acc.reconcile_reported_usage(
+        {"input_tokens": 999, "output_tokens": 3, "total_tokens": 1002}
+    )
+
+    with pytest.raises(EvidenceIncompleteError, match="reported input usage"):
+        acc.finalize("completed")
+
+
+def test_failed_receipt_can_express_absence_and_then_freezes():
+    acc = _accumulator()
+    terminal = acc.finalize("failed")
+    assert terminal["terminalEvidence"]["inputUsage"] == {"present": False, "value": 0}
+    assert terminal["terminalEvidence"]["terminalStatus"] == "failed"
+    with pytest.raises(EvidenceFrozenError):
+        acc.record_provider_attempt(
+            provider="ollama-cloud",
+            model="late",
+            transport_class="openai_chat_completions",
+            billing_class="subscription_included",
+        )
+
+
+def test_canonical_digest_is_order_independent_and_value_sensitive():
+    left = {"schemaVersion": "v", "turnTotal": 1, "nested": {"b": 2, "a": "é"}}
+    right = {"nested": {"a": "é", "b": 2}, "turnTotal": 1, "schemaVersion": "v"}
+    changed = {"nested": {"a": "é", "b": 3}, "turnTotal": 1, "schemaVersion": "v"}
+    assert canonical_projection_bytes(left) == canonical_projection_bytes(right)
+    assert terminal_evidence_digest(left) == terminal_evidence_digest(right)
+    assert terminal_evidence_digest(left) != terminal_evidence_digest(changed)
+
+
+def test_canonical_projection_rejects_float_negative_and_non_ascii_keys():
+    for projection in ({"x": 1.5}, {"x": -1}, {"é": "value"}):
+        with pytest.raises(EvidenceError):
+            canonical_projection_bytes(projection)
