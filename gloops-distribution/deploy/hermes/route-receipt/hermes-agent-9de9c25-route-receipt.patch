+from types import SimpleNamespace
+
+import pytest
+
+from gateway.run_evidence import (
+    EvidenceError,
+    EvidenceFrozenError,
+    EvidenceIncompleteError,
+    RunEvidenceAccumulator,
+    canonical_projection_bytes,
+    extract_usage_presence,
+    terminal_evidence_digest,
+)
+
+
+def _response(*, model="qwen3-coder", prompt=12, output=3, cached=0):
+    details = SimpleNamespace(cached_tokens=cached)
+    usage = SimpleNamespace(
+        prompt_tokens=prompt,
+        completion_tokens=output,
+        prompt_tokens_details=details,
+    )
+    return SimpleNamespace(model=model, usage=usage)
+
+
+def _accumulator():
+    return RunEvidenceAccumulator(
+        run_id="run_test",
+        request_byte_length=2,
+        request_sha256="4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e6f15fc2f9f7f57c15e3fcb",
+    )
+
+
+def _record_success(acc, *, model="qwen3-coder", response=None, tools=0):
+    route = {
+        "provider": "ollama-cloud",
+        "model": model,
+        "transport_class": "openai_chat_completions",
+        "billing_class": "subscription_included",
+    }
+    acc.record_provider_attempt(**route)
+    acc.record_provider_response(
+        response=response or _response(model=model),
+        tool_call_count=tools,
+        **route,
+    )
+
+
+def test_legitimate_zero_is_present_but_absent_cache_is_not():
+    present = extract_usage_presence(
+        SimpleNamespace(
+            prompt_tokens=10,
+            completion_tokens=0,
+            prompt_tokens_details=SimpleNamespace(cached_tokens=0),
+        ),
+        "openai_chat_completions",
+    )
+    assert present["input"].present is True
+    assert present["input"].value == 10
+    assert present["output"].present is True
+    assert present["output"].value == 0
+    assert present["cached"].present is True
+    assert present["cached"].value == 0
+
+    absent = extract_usage_presence(
+        SimpleNamespace(prompt_tokens=10, completion_tokens=0),
+        "openai_chat_completions",
+    )
+    assert absent["input"].present is True
+    assert absent["input"].value == 10
+    assert absent["output"].present is True
+    assert absent["output"].value == 0
+    assert absent["cached"].present is False
+
+
+@pytest.mark.parametrize("value", [-1, True, 1.5, "1"])
+def test_invalid_usage_values_fail(value):
+    with pytest.raises(EvidenceError):
+        extract_usage_presence(
+            SimpleNamespace(
+                prompt_tokens=value,
+                completion_tokens=1,
+                prompt_tokens_details=SimpleNamespace(cached_tokens=0),
+            ),
+            "openai_chat_completions",
+        )
+
+
+def test_completed_receipt_uses_actual_route_and_aggregates_turns():
+    acc = _accumulator()
+    acc.record_provider_attempt(
+        provider="ollama-cloud",
+        model="primary-ollama-model",
+        transport_class="openai_chat_completions",
+        billing_class="subscription_included",
+    )
+    _record_success(acc, tools=2)
+    _record_success(acc, response=_response(prompt=8, output=4, cached=2), tools=1)
+
+    terminal = acc.finalize("completed")
+    evidence = terminal["terminalEvidence"]
+    assert evidence["resolvedProvider"] == "ollama-cloud"
+    assert evidence["resolvedModel"] == "qwen3-coder"
+    assert [route["provider"] for route in evidence["fallbackPath"]] == [
+        "ollama-cloud",
+        "ollama-cloud",
+        "ollama-cloud",
+    ]
+    assert evidence["turnTotal"] == 2
+    assert evidence["toolCallTotal"] == 3
+    assert evidence["inputUsage"] == {"present": True, "value": 20}
+    assert evidence["outputUsage"] == {"present": True, "value": 7}
+    assert evidence["cachedUsage"] == {"present": True, "value": 2}
+    assert set(evidence) == {
+        "schemaVersion",
+        "hermesRunId",
+        "requestByteLength",
+        "requestSha256",
+        "resolvedProvider",
+        "resolvedModel",
+        "transportClass",
+        "billingClass",
+        "fallbackPath",
+        "inputUsage",
+        "outputUsage",
+        "cachedUsage",
+        "usageSource",
+        "turnTotal",
+        "toolCallTotal",
+        "terminalStatus",
+    }
+    assert terminal["terminalEvidenceDigest"] == terminal_evidence_digest(evidence)
+
+
+def test_retries_on_same_route_remain_distinct_attempts():
+    acc = _accumulator()
+    route = {
+        "provider": "ollama-cloud",
+        "model": "qwen3-coder",
+        "transport_class": "openai_chat_completions",
+        "billing_class": "subscription_included",
+    }
+    acc.record_provider_attempt(**route)
+    acc.record_provider_attempt(**route)
+    acc.record_provider_response(response=_response(), tool_call_count=0, **route)
+    assert len(acc.finalize("completed")["terminalEvidence"]["fallbackPath"]) == 2
+
+
+def test_completed_receipt_rejects_any_api_billed_fallback_attempt():
+    acc = _accumulator()
+    acc.record_provider_attempt(
+        provider="openai",
+        model="gpt-5",
+        transport_class="openai_chat_completions",
+        billing_class="official_docs_snapshot",
+    )
+    _record_success(acc)
+
+    with pytest.raises(
+        EvidenceIncompleteError,
+        match="outside the Ollama Cloud subscription boundary",
+    ):
+        acc.finalize("completed")
+
+
+def test_missing_usage_and_model_contradiction_fail_completed_terminalization():
+    missing = _accumulator()
+    route = {
+        "provider": "ollama-cloud",
+        "model": "qwen3-coder",
+        "transport_class": "openai_chat_completions",
+        "billing_class": "subscription_included",
+    }
+    missing.record_provider_attempt(**route)
+    missing.record_provider_response(
+        response=SimpleNamespace(model="qwen3-coder", usage=None),
+        tool_call_count=0,
+        **route,
+    )
+    with pytest.raises(EvidenceIncompleteError, match="inputUsage"):
+        missing.finalize("completed")
+
+    contradiction = _accumulator()
+    contradiction.record_provider_attempt(**route)
+    contradiction.record_provider_response(
+        response=_response(model="different-model"),
